# Local Terraform providers, state, saved plans, and crash logs.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Ignore local variable files, but commit the reviewed infrastructure settings.
*.tfvars
*.tfvars.json
!/infra/infrastructure.tfvars
!/infra/config/azure.tfvars
!/infra/config/environments.tfvars
!/infra/config/solutions.tfvars
!/infra/config/tenant.tfvars

# GitHub injects deployment credentials; never commit local environment files.
.env

# Commit .terraform.lock.hcl for reproducible provider installation.